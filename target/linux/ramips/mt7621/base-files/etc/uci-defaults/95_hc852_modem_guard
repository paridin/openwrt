#!/bin/sh

. /lib/functions/system.sh

[ "$(board_name)" = "huastlink,hc852" ] || exit 0

if ! uci -q get hc852.modem_guard >/dev/null; then
	uci set hc852.modem_guard="settings"
fi

# Stable default: keep only one modem authorized to avoid xHCI -12 resource errors.
uci set hc852.modem_guard.mode='single'
uci set hc852.modem_guard.primary_usb_path='1-1.2'
uci set hc852.modem_guard.secondary_usb_path='1-1.3'
uci set hc852.modem_guard.allow_secondary_fallback='1'

uci commit hc852

[ -x /etc/init.d/hc852_modem_guard ] && /etc/init.d/hc852_modem_guard enable >/dev/null 2>&1
[ -x /etc/init.d/hc852_modem_recover ] && /etc/init.d/hc852_modem_recover enable >/dev/null 2>&1
[ -x /etc/init.d/hc852_shutdown_guard ] && /etc/init.d/hc852_shutdown_guard enable >/dev/null 2>&1
[ -x /usr/sbin/hc852_modem_guard ] && /usr/sbin/hc852_modem_guard apply >/dev/null 2>&1

exit 0
