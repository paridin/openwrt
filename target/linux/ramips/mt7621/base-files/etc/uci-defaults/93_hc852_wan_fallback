#!/bin/sh

. /lib/functions/system.sh

board="$(board_name)"
[ "$board" = "huastlink,hc852" ] || exit 0

carrier() {
	local dev="$1"
	[ -r "/sys/class/net/${dev}/carrier" ] || {
		echo 0
		return
	}
	cat "/sys/class/net/${dev}/carrier" 2>/dev/null || echo 0
}

pick_fallback_wan() {
	# Priority by silk-screen order for user wiring:
	# WAN (dedicated) -> LAN4 -> LAN3
	if [ "$(carrier lan4)" = "1" ]; then
		echo "lan4"
		return
	fi
	if [ "$(carrier lan3)" = "1" ]; then
		echo "lan3"
		return
	fi
	echo ""
}

# Default mapping is WAN=wan. If dedicated WAN has no carrier on first boot,
# fallback to LAN4/LAN3 but only when LAN2 is already used for management.
[ "$(uci -q get network.wan.device)" = "wan" ] || exit 0

# Keep stock-like WAN priority when multiple uplinks are present.
[ -n "$(uci -q get network.wan.metric)" ] || uci set network.wan.metric='10'
[ -n "$(uci -q get network.wan6.metric)" ] || uci set network.wan6.metric='10'

[ "$(carrier wan)" = "0" ] || exit 0
[ "$(carrier lan2)" = "1" ] || exit 0

fallback_dev="$(pick_fallback_wan)"
[ -n "$fallback_dev" ] || exit 0

if uci -q show network.@device[0].ports | grep -q "'${fallback_dev}'"; then
	uci -q del_list network.@device[0].ports="${fallback_dev}"
fi

uci set network.wan.device="${fallback_dev}"
uci set network.wan.proto='dhcp'
uci commit network

logger -t hc852 "WAN fallback enabled on first boot: network.wan.device=${fallback_dev}"

exit 0
