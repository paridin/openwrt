#!/bin/sh /etc/rc.common

START=97
USE_PROCD=1

start_service() {
	[ -x /usr/sbin/hc852_modem_recover ] || return 0

	procd_open_instance
	procd_set_param command /bin/sh -c 'while true; do /usr/sbin/hc852_modem_recover tick; sleep 10; done'
	procd_set_param respawn 5 5 0
	procd_close_instance
}

reload_service() {
	stop
	start
}
