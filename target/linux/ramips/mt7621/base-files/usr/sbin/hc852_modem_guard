#!/bin/sh

. /lib/functions/system.sh

board="$(board_name)"
[ "$board" = "huastlink,hc852" ] || exit 0

CFG_PKG="hc852"
CFG_SEC="modem_guard"
LOCKFILE="/var/lock/hc852_modem_guard.lock"
STAMPFILE="/var/run/hc852_modem_guard.last_apply"
DEBOUNCE_SEC=8

lock "$LOCKFILE" >/dev/null 2>&1
trap 'lock -u "$LOCKFILE" >/dev/null 2>&1' EXIT INT TERM HUP

get_cfg() {
	local opt="$1"
	local def="$2"
	local val

	val="$(uci -q get "${CFG_PKG}.${CFG_SEC}.${opt}")"
	[ -n "$val" ] || val="$def"
	echo "$val"
}

MODE="$(get_cfg mode single)"
PRIMARY_PATH="$(get_cfg primary_usb_path 1-1.2)"
SECONDARY_PATH="$(get_cfg secondary_usb_path 1-1.3)"
ALLOW_SECONDARY_FALLBACK="$(get_cfg allow_secondary_fallback 0)"

authorized_file() {
	local path="$1"
	echo "/sys/bus/usb/devices/${path}/authorized"
}

has_usb_dev() {
	local path="$1"
	[ -d "/sys/bus/usb/devices/${path}" ]
}

set_authorized() {
	local path="$1"
	local state="$2"
	local f

	f="$(authorized_file "$path")"
	[ -w "$f" ] || return 1
	echo "$state" > "$f" 2>/dev/null || return 1
	return 0
}

should_skip_apply() {
	local reason="$1"
	local last now delta

	[ "$reason" = "force" ] && return 1
	[ "${HC852_GUARD_FORCE:-0}" = "1" ] && return 1

	last="$(cat "$STAMPFILE" 2>/dev/null)"
	now="$(date +%s 2>/dev/null)"

	case "$last" in
	''|*[!0-9]*) return 1 ;;
	esac
	case "$now" in
	''|*[!0-9]*) return 1 ;;
	esac

	delta=$((now - last))
	[ "$delta" -lt "$DEBOUNCE_SEC" ]
}

mark_apply() {
	date +%s > "$STAMPFILE" 2>/dev/null || true
}

apply_mode_single() {
	# Keep primary modem online, hard-disable secondary to avoid xHCI resource exhaustion.
	set_authorized "$PRIMARY_PATH" 1 >/dev/null 2>&1 || true

	if has_usb_dev "$PRIMARY_PATH"; then
		set_authorized "$SECONDARY_PATH" 0 >/dev/null 2>&1 || true
	elif [ "$ALLOW_SECONDARY_FALLBACK" = "1" ]; then
		set_authorized "$SECONDARY_PATH" 1 >/dev/null 2>&1 || true
	else
		set_authorized "$SECONDARY_PATH" 0 >/dev/null 2>&1 || true
	fi
}

apply_mode_dual() {
	set_authorized "$PRIMARY_PATH" 1 >/dev/null 2>&1 || true
	set_authorized "$SECONDARY_PATH" 1 >/dev/null 2>&1 || true
}

switch_to() {
	local target="$1"

	case "$target" in
	primary)
		set_authorized "$SECONDARY_PATH" 0 >/dev/null 2>&1 || true
		set_authorized "$PRIMARY_PATH" 1 >/dev/null 2>&1 || true
		;;
	secondary)
		set_authorized "$PRIMARY_PATH" 0 >/dev/null 2>&1 || true
		set_authorized "$SECONDARY_PATH" 1 >/dev/null 2>&1 || true
		;;
	esac

	# Allow /dev/cdc-wdm* recreation after authorization toggle.
	sleep 2
	[ -x /usr/sbin/hc852_modem_autoselect ] && /usr/sbin/hc852_modem_autoselect switch >/dev/null 2>&1
}

status() {
	local p s
	p="$(cat "$(authorized_file "$PRIMARY_PATH")" 2>/dev/null || echo "?")"
	s="$(cat "$(authorized_file "$SECONDARY_PATH")" 2>/dev/null || echo "?")"
	echo "mode=${MODE} primary=${PRIMARY_PATH}:${p} secondary=${SECONDARY_PATH}:${s}"
}

case "$1" in
apply|"")
	if should_skip_apply "${2:-}"; then
		exit 0
	fi

	case "$MODE" in
	dual) apply_mode_dual ;;
	*) apply_mode_single ;;
	esac
	# Re-bind LTE interface after USB authorization policy changes.
	sleep 1
	[ -x /usr/sbin/hc852_modem_autoselect ] && /usr/sbin/hc852_modem_autoselect apply >/dev/null 2>&1
	mark_apply
	logger -t hc852 "modem_guard apply: mode=${MODE} primary=${PRIMARY_PATH} secondary=${SECONDARY_PATH}"
	;;
primary)
	switch_to primary
	logger -t hc852 "modem_guard switched to primary (${PRIMARY_PATH})"
	;;
secondary)
	switch_to secondary
	logger -t hc852 "modem_guard switched to secondary (${SECONDARY_PATH})"
	;;
status)
	status
	;;
esac

exit 0
