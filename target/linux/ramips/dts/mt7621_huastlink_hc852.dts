#include "mt7621.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "huastlink,hc852", "mediatek,mt7621-soc";
	model = "Huastlink HC852";

	aliases {
		label-mac-device = &gmac0;
		led-boot = &led_sys;
		led-failsafe = &led_sys;
		led-running = &led_sys;
		led-upgrade = &led_sys;
	};

	chosen {
		/*
		 * Override MT7621 default (57600) to keep serial output stable
		 * with common USB-TTL adapters.
		 */
		stdout-path = "serial0:115200n8";
		bootargs = "console=ttyS0,115200 rootfstype=squashfs,jffs2";
	};

	gpio-keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio 18 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		wps {
			label = "wps";
			gpios = <&gpio 15 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	gpio-leds {
		compatible = "gpio-leds";

		led_sys: sys {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio 17 GPIO_ACTIVE_LOW>;
		};

		net {
			label = "green:net";
			gpios = <&gpio 16 GPIO_ACTIVE_LOW>;
		};

		mesh {
			label = "green:mesh";
			gpios = <&gpio 3 GPIO_ACTIVE_LOW>;
		};
	};
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x00000 0x30000>;
				read-only;
			};

			partition@30000 {
				label = "config";
				reg = <0x30000 0x10000>;
				read-only;
			};

			factory: partition@50000 {
				label = "factory";
				reg = <0x50000 0x40000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_factory_4: macaddr@4 {
						compatible = "mac-base";
						reg = <0x4 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};

			partition@90000 {
				compatible = "denx,fit";
				label = "firmware";
				reg = <0x90000 0x1f70000>;
			};
		};
	};
};

&gmac0 {
	nvmem-cells = <&macaddr_factory_4 0>;
	nvmem-cell-names = "mac-address";
};

&gmac1 {
	status = "okay";
	label = "wan";
	phy-handle = <&ethphy4>;
	nvmem-cells = <&macaddr_factory_4 1>;
	nvmem-cell-names = "mac-address";
};

&ethphy4 {
	/delete-property/ interrupts;
};

&ethernet {
	pinctrl-0 = <&mdio_pins>, <&rgmii1_pins>;
};

&switch0 {
	ports {
		port@0 {
			status = "okay";
			label = "lan1";
		};

		port@1 {
			status = "okay";
			label = "lan2";
		};

		port@2 {
			status = "okay";
			label = "lan3";
		};

		port@3 {
			status = "okay";
			label = "lan4";
		};

		port@4 {
			status = "okay";
			label = "wan";
		};
	};
};

&pcie {
	status = "okay";

	/*
	 * Derived from the vendor DTB extracted from running firmware.
	 * Keeping all reset lines avoids partial PCIe initialization.
	 */
	reset-gpios = <&gpio 19 GPIO_ACTIVE_LOW>,
		      <&gpio 27 GPIO_ACTIVE_LOW>,
		      <&gpio 1 GPIO_ACTIVE_LOW>;
};

/*
 * Keep PCIe slots generic for LTE/WWAN cards.
 * Do not pre-bind mt76 Wi-Fi nodes on this board variant.
 */
&pcie0 {
	status = "okay";
};

&pcie1 {
	status = "okay";
};

&xhci {
	status = "okay";
	/*
	 * Keep LTE modems on USB2 path for stability on this board.
	 * This reduces xHCI resource pressure seen as "can't set config #1".
	 */
	mediatek,u3p-dis-msk = <0x1>;
};

&state_default {
	gpio {
		groups = "i2c", "jtag", "uart2", "uart3", "wdt";
		function = "gpio";
	};
};
